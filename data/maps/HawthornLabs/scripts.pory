mapscripts HawthornLabs_MapScripts {
    MAP_SCRIPT_ON_LOAD {
		setflag(FLAG_VISITED_OLDALE_TOWN)
		// INTRO: Rival needs to be readded
		if (var(VAR_INTRO_SEQUENCE_STATE) == 4) {
			// Make sure this flag is unset
			clearflag(FLAG_INTRO_MET_MOM)
			addobject(LOCALID_LABEXT_RIVAL)
		}
	}
}

script HawthornLabs_Sign {
	msgbox(
        "HAWTHORN LABS
        
		Someone has added to the sign, in
		big red letters:
		
		\qo{COLOR RED}NO SOLICITORS{COLOR DARK_GRAY}\qc", 
        MSGBOX_SIGN
    )
}

script HawthornLabs_Talk_Scientist {
	lock
	faceplayer
	msgbox(
        "Professor Hawthorn's research is
		focused on Pok\emon types.
		
		The Professor has some very
		interesting theories regarding them.
		
		…I think. She hasn't actually told me
		what we're working on.", 
        MSGBOX_DEFAULT
    )
	release
}

script HawthornLabs_Talk_Receptionist {
	lock
	faceplayer
	msgbox(
        "Professor Hawthorn…
		
		She bosses me around a lot.
		I mean, she's my boss, but- 
		
		Um, nevermind.", 
        MSGBOX_DEFAULT
    )
	release
}

script HawthornLabs_Intro_MeetRival {
	lockall
	turnobject(LOCALID_PLAYER, DIR_NORTH)
    applymovement(LOCALID_LABEXT_RIVAL, moves(
		jump_in_place_down
		delay_16
	))
	msgbox(
        "MAYA: There you are!
		The lab is just up ahead!", 
        MSGBOX_DEFAULT
    )
	closemessage
	delay(30)
	
	getplayerxy(VAR_0x8008, VAR_0x8009)
	applymovement(LOCALID_LABEXT_RIVAL, moves(
		walk_up * 5
		walk_left
		walk_up * 4
		delay_16
		face_down
	))
	delay(10)
	switch(var(VAR_0x8008)) {
		case 10:
			applymovement(LOCALID_PLAYER, moves(
				walk_up * 5
				delay_16
				walk_up * 4
			))
		case 11:
			applymovement(LOCALID_PLAYER, moves(
				walk_up * 6
				walk_left
				walk_up * 3
			))
		case 12:
			applymovement(LOCALID_PLAYER, moves(
				walk_left
				walk_up * 6
				walk_left
				walk_up * 3
			))
	}
	waitmovement(0)
	delay(30)
	
	msgbox(
        "MAYA: I heard that Professor Hawthorn
		can be a bit… {PAUSE 30}prickly?
		
		My dad met her once, I think.
		
		…But I'm sure once we explain the
		situation, it'll be all good.
		
		Alright, {PLAYER}! No hesitating!
		Let's go!", 
        MSGBOX_DEFAULT
    )
	closemessage
	delay(10)
    turnobject(LOCALID_LABEXT_RIVAL, DIR_NORTH)
	opendoor(10, 8)
    waitdooranim
	applymovement(LOCALID_LABEXT_RIVAL, moves(
		walk_up
	))
	waitmovement(0)
	removeobject(LOCALID_LABEXT_RIVAL)
	//removeobject sets the story flag. clear it again
	clearflag(FLAG_INTRO_MET_MOM)
	
	applymovement(LOCALID_PLAYER, moves(
		walk_up * 2
	))
	waitmovement(0)
	hideobjectat(LOCALID_PLAYER, 0)
	closedoor(10, 8)
	waitdooranim
	playse(SE_EXIT)
    warp(MAP_HAWTHORN_LABS_INTERIOR, 0)
    waitstate
    releaseall
}

script HawthornLabs_Intro_BattleRival {
	lockall
	
	getplayerxy(VAR_0x8008, VAR_0x8009)
	switch(var(VAR_0x8008)) {
		case 10:
			applymovement(LOCALID_PLAYER, moves(
				walk_right
				walk_down * 2
			))
		case 11:
			applymovement(LOCALID_PLAYER, moves(
				walk_down * 2
			))
		case 12:
			applymovement(LOCALID_PLAYER, moves(
				walk_left
				walk_down * 2
			))
	}
	waitmovement(0)
	delay(30)
	msgbox(
        "MAYA: …So, that's what Professor
         Hawthorn is like.
		
		I can see why she has the reputation
		that she does.
		
		But she was willing to help. I feel like
		we actually have a chance of finding
		these Pok\emons' trainer, now.", 
        MSGBOX_DEFAULT
    )
	closemessage
    fadeoutbgm(1)
    turnobject(LOCALID_LABEXT_RIVAL, DIR_EAST)
	delay(30)
	msgbox(
        "And in the meantime, we'll keep these
		ones with us…", 
        MSGBOX_DEFAULT
    )
	closemessage
	delay(60)
    turnobject(LOCALID_LABEXT_RIVAL, DIR_NORTH)
	msgbox(
        "…{PLAYER}.
		
		I guess this makes us Pok\emon 
		trainers now, huh?
		
		…You know what that means, right?", 
        MSGBOX_DEFAULT
    )
	applymovement(LOCALID_LABEXT_RIVAL, moves(
		jump_in_place_up * 2
	))
	waitmovement(0)
	playbgm(MUS_ENCOUNTER_MAY, TRUE)
	msgbox(
        "{PLAYER}!
		
		I can sense these Pok\emons' energy!
		They're raring for some action!
		
		Let's duke it out!
		I challenge you to a Pok\emon battle!",
        MSGBOX_DEFAULT
    )
	
	switch(var(VAR_STARTER_MON)) {
	case 0: // player picked grass
		trainerbattle_earlyrival(TRAINER_RIVAL_INTRO_FIRE, RIVAL_BATTLE_LOSEABLE, HawthornLabs_Intro_BattleRival_PlayerWin, HawthornLabs_Intro_BattleRival_PlayerLose)
	case 1: // player picked fire
		trainerbattle_earlyrival(TRAINER_RIVAL_INTRO_WATER, RIVAL_BATTLE_LOSEABLE, HawthornLabs_Intro_BattleRival_PlayerWin, HawthornLabs_Intro_BattleRival_PlayerLose)
	case 2: // player picked water
		trainerbattle_earlyrival(TRAINER_RIVAL_INTRO_GRASS, RIVAL_BATTLE_LOSEABLE, HawthornLabs_Intro_BattleRival_PlayerWin, HawthornLabs_Intro_BattleRival_PlayerLose)
	}
	
	// after battle
	fadedefaultbgm
	
	msgbox(
        "MAYA: Wow!
		
		Even with such small Pok\emon,
		that was exhilirating!
		
		I think I get why people go nuts
		for Pok\emon battles now.
		
		Okay, {PLAYER}!
		We've had our fun, but now we have a
		mission!
		
		Let's go home for now. We should get
		some rest, and get ready.
		
		And I need to tell my family…
		
		I'll see you back in town, okay?",
        MSGBOX_DEFAULT
    )
	closemessage
	
	applymovement(LOCALID_LABEXT_RIVAL, moves(
		walk_down * 2
		delay_16 * 2
		walk_fast_down * 6
	))
	waitmovement(0)
	removeobject(LOCALID_LABEXT_RIVAL)
    setobjectxyperm(LOCALID_LABEXT_RIVAL, 47, 0)
	
	setvar(VAR_INTRO_SEQUENCE_STATE, 5)
	addplayerlevel(1)
	
	warp(MAP_MARINACRE_TOWN_PLAYER_HOUSE_1F, 0)
    waitstate
	
	releaseall
}

text HawthornLabs_Intro_BattleRival_PlayerWin {
	"Your Pok\emon is so strong!"
}
text HawthornLabs_Intro_BattleRival_PlayerLose {
	"Woo! This Pok\emon is strong!"
}