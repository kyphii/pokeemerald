mapscripts MountBriar_MapScripts {}

script MountBriar_Talk_LiftAttendant {
	lock
	faceplayer
	msgbox(MountBriar_Text_RideLift, MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		closemessage
		release
		applymovement(LOCALID_PLAYER, moves(
			walk_right
			walk_up
		))
		waitmovement(0)
		goto(MountBriar_Script_RideLift)
	}
	else {
		closemessage
		release
	}
}

script MountBriar_Trigger_LiftAttendant {
	lock
	turnobject(LOCALID_LIFT_ATTENDANT, DIR_EAST)
	turnobject(LOCALID_PLAYER, DIR_WEST)
	msgbox(MountBriar_Text_RideLift, MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		goto(MountBriar_Script_RideLift)
	}
	release
}

script MountBriar_Script_RideLift {
	closemessage
	
	// respawn chair
	removeobject(LOCALID_SKI_LIFT)
	addobject(LOCALID_SKI_LIFT)
	
	applymovement(LOCALID_PLAYER, moves(
		walk_up * 3
	))
	waitmovement(0)
	delay(20)
	
	applymovement(LOCALID_PLAYER, MountBriar_Moves_SkiLift)
	delay(1)
	applymovement(LOCALID_SKI_LIFT, MountBriar_Moves_SkiLift)
	waitmovement(0)
	
	applymovement(LOCALID_PLAYER, moves(
		force_up
		jump_up
	))
	waitmovement(0)
}

script MountBriar_Talk_CutMaster {
	lock
	applymovement(VAR_LAST_TALKED, moves(
		walk_in_place_left * 2
	))
	waitmovement(0)
	msgbox(
		"Observe, if you will,
		the obstacle before you.
		
		Contemplate its shape.
		In every shape lies a weakness,
		a fault plane.
		
		Align your blade with that…
		and then…{PAUSE 30} release!",
		MSGBOX_DEFAULT
	)
	playmoncry(SPECIES_SCYTHER, 0)
	delay(15)
	applymovement(LOCALID_MOUNTBRIAR_TREE, Movement_CutTreeDown)
	waitmovement(0)
	removeobject(LOCALID_MOUNTBRIAR_TREE)
	
	delay(15)
	faceplayer
	
	msgbox(
		"To have sought me out on this 
		mountain… you seek the CUT technique, 
		surely.
		
		Very well!
		
		If you are truly dedicated to obtain my
		secret art…
		
		Then find me once more, in my most
		secret of sanctuaries!
		I will be waiting!",
		MSGBOX_DEFAULT
	)
	closemessage
	
	turnobject(VAR_LAST_TALKED, DIR_WEST)
	delay(20)
	removeobject(LOCALID_MOUNTBRIAR_CUTMASTERMON)
	playse(SE_BALL)
	
	delay(30)
	
	applymovement(VAR_LAST_TALKED, moves(
		walk_left * 3
		walk_down
		delay_16 * 2
		walk_in_place_faster_down * 4
		force_down * 3
		face_right
		force_right
		face_down
		force_down
		face_right
		force_right * 6
		face_down
		force_down
		face_right
		force_right
		face_down
		force_down * 2
	))
	waitmovement(0)
	
	removeobject(VAR_LAST_TALKED)
	setflag(FLAG_STORY_MET_CUT_MASTER)
	clearflag(FLAG_STORY_CUT_MASTER_AWAY)
	
	release
}

script MountBriar_Talk_CutMasterMon {
	playmoncry(SPECIES_SCYTHER, 0)
	waitmoncry
	msgbox(
		"Scyther is focused intently, ready to
		strike.",
		MSGBOX_DEFAULT
	)
	closemessage
}

text MountBriar_Text_RideLift {
	"Hello. Do you want to ride the lift 
	to the summit?"
}

movement MountBriar_Moves_SkiLift {
	force_up * 46
}
