mapscripts NautirustCity_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if (!flag(FLAG_VISITED_NAUTIRUST_CITY)) {
			setflag(FLAG_VISITED_NAUTIRUST_CITY)
			
			// Setup flags for story Act 1
			setflag(FLAG_STORY_CUT_MASTER_AWAY)
			// Scene on Route 20 unsets this flag
			setflag(FLAG_STORY_ROUTE4_TRAIL_HINT)
			addplayerlevel(1)
			
			// Move Maya here for story
			setvar(VAR_MAYA_CURRENT_CITY, 1)
			setvar(VAR_MAYA_CURRENT_POSITION, 0)
		}
	}
	MAP_SCRIPT_ON_LOAD {
		if (var(VAR_MAYA_CURRENT_CITY) == 1) {
			if (var(VAR_MAYA_CURRENT_POSITION) != 0) {
				setvar(VAR_0x8004, 5)
				special(RandomizeMayaLocation)
			}
			switch (var(VAR_MAYA_CURRENT_POSITION)) {
				case 1:
					setobjectxyperm(LOCALID_NAUTIRUST_MAYA, 7, 12)
				case 2:
					setobjectxyperm(LOCALID_NAUTIRUST_MAYA, 29, 20)
				case 3:
					setobjectxyperm(LOCALID_NAUTIRUST_MAYA, 14, 38)
				default:
					setobjectxyperm(LOCALID_NAUTIRUST_MAYA, 0, -8)
			}
		}
	}
}

script NautirustCity_Sign_TrainerAcademy {
	msgbox(
        "Nautirust Trainer's Academy", 
        MSGBOX_SIGN
    )
}

script NautirustCity_Sign_TownSign {
	msgbox(
        "NAUTIRUST CITY
        Streams of energy, powering the gears 
		of history.", 
        MSGBOX_SIGN
    )
}

script NautirustCity_Sign_GymSign {
	msgbox(
        "NAUTIRUST CITY Pok\emon Gym
        Leader: Landon
		The Sultan of Soil!", 
        MSGBOX_SIGN
    )
}

script NautirustCity_Script_TalkMaya {
	lock
	faceplayer
	switch (var(VAR_MAYA_CURRENT_POSITION)) {
		case 1:
			getplayerlevel
			if (flag(FLAG_BADGE01_GET)) {
				msgbox(
					"MAYA: Woah, {PLAYER}!
					You beat the gym challenge too?
					
					That means it's official!
					We're rivals now!
					
					You're on, {PLAYER}!
					I'm gonna beat all the gyms in Wohnet 
					first!
					
					You better keep up! 
					I need you to keep me sharp!",
					MSGBOX_DEFAULT
				)
			}
			elif (var(VAR_RESULT) < 12) {
				msgbox(
					"MAYA: Hey!
					
					Did you take a look inside the gym yet?
					
					I checked it out, but they told me I
					should train more before I can
					challenge the Gym Leader.
					
					Okay, {PLAYER}!
					Let's get strong enough to take on
					that gym!",
					MSGBOX_DEFAULT
				)
			}
			else {
				msgbox(
					"MAYA: Hey, {PLAYER}!
					Guess what?
					
					I got a gym badge!
					
					You should try it out too.
					You better keep up with me!",
					MSGBOX_DEFAULT
				)
			}
		case 2:
			msgbox(
				"MAYA: To be honest, I never really liked 
				passing through this city before.

				It always seemed so dreary.

				But now that we're traveling with 
				Pok\emon…

				I dunno. It's making me see things 
				through a different lens, I guess.",
				MSGBOX_DEFAULT
			)
		case 3:
			msgbox(
				"MAYA: So, if we go west from here, it'll 
				take us through Whelchord City, and 
				then to the Pok\e Ball factory in 
				Armiter City.

				Or we could go south through Junopolis 
				City to reach Canvenas City.
				
				It's gonna be a pretty long journey 
				either way.

				Which road should we take?",
				MSGBOX_DEFAULT
			)
	}
	setvar(VAR_0x8004, 5)
	special(RandomizeMayaLocation)
	closemessage
	release
}

script NautirustCity_Script_TalkGreeter {
	lock
	faceplayer
	msgbox(
		"Hi!
		Are you from out of town?
		
		There are a lot of trainers like you
		passing through these days.
		
		Lucky for you, Nautirust has everything
		that a trainer needs!
		
		You can get your Pok\emon healed at
		the Pok\emon Center, right here.
		
		There's also a Pok\e Mart just up the
		street.
		
		We're even part of the Wohnet Pok\emon 
		League, with our very own Pok\emon Gym!
		It's run by a guy named Landon.",
		MSGBOX_DEFAULT
	)
	closemessage
	release
}

script NautirustCity_Script_TalkMan1 {
	lock
	faceplayer
	msgbox(
		"All these buildings used to be 
		factories.
		
		Nowadays, though, most of them have 
		been made into apartments.
		
		Sometimes it feels strange, to live in
		a space that was never built for 
		that purpose.",
		MSGBOX_DEFAULT
	)
	closemessage
	release
}

script NautirustCity_Script_TalkBenchGirl {
	lock
	faceplayer
	msgbox(
		"The canals are so nice now that the
		city's cleaned them up!
		
		I used to hate living here, but now I 
		can't imagine being anywhere else!",
		MSGBOX_DEFAULT
	)
	closemessage
	release
}

script NautirustCity_Script_TalkExpShareStore {
	lock
	faceplayer
	if (!flag(FLAG_RECEIVED_EXP_SHARE)) {
		message(
			"Hi there!
			
			My days as a Pok\emon trainer are 
			behind me, so I'm selling my old gear.
			
			I have an Exp. All here.
			Want to buy it?"
		)
		waitmessage
		showmoneybox(0, 0)
		dynmultichoice(14, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE,
			"EXP. ALL{CLEAR_TO 0x49}{FONT_SMALL}¥5,000", "No thanks")
		switch(var(VAR_RESULT)) {
			case 0:
				checkmoney(5000)
				if (var(VAR_RESULT) == TRUE) {
					msgbox(
						"Here you go!",
						MSGBOX_DEFAULT
					)
					removemoney(5000)
					hidemoneybox
					giveitem(ITEM_EXP_SHARE, 1)
					setflag(FLAG_RECEIVED_EXP_SHARE)
					addplayerlevel(1)
					
					msgbox(
						"Turn the Exp. All on?",
						MSGBOX_YESNO
					)
					if (var(VAR_RESULT) == TRUE) {
						playse(SE_POKENAV_ON)
						msgbox(
							"You turned on the Exp. All."
						)
						setflag(FLAG_EXP_SHARE_ENABLED)
					}
					
					msgbox(
						"Thank you!",
						MSGBOX_DEFAULT
					)
					closemessage
					release
				}
				else {
					hidemoneybox
					msgbox(
						"Sorry!
						You don't have enough money…
						
						Maybe come back later?",
						MSGBOX_DEFAULT
					)
					closemessage
					release
				}
			case 1:
				hidemoneybox
				msgbox(
					"Thanks for stopping by!",
					MSGBOX_DEFAULT
				)
				closemessage
				release
		}
	}
	else {
		msgbox(
			"I'm all out of stock, but I still have a
			lease for this stand.
			
			Maybe I could sell other things?",
			MSGBOX_DEFAULT
		)
		closemessage
		release
	}
}