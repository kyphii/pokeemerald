mapscripts MarinacreTown_PlayerHouse_2F_MapScripts {
    MAP_SCRIPT_ON_LOAD {
		if (var(VAR_INTRO_SEQUENCE_STATE) == 0) {
			setflag(FLAG_SYS_B_DASH)
			setflag(FLAG_RECEIVED_RUNNING_SHOES)
			setplayerlevel(4)
			
			pausertc(20)
		}
	}
}

script MarinacreTown_PlayerHouse_2F_Sign_NintendoSwitch {
	msgbox("It's your Nintendo Switch.
		When was the last time you used it?", 
		MSGBOX_SIGN)
}

script MarinacreTown_PlayerHouse_2F_Mirror {
	lockall
	msgbox(
		"An ordinary table mirror.
		In it, you see your reflection…
		
		…Or maybe not?
		
		Do you want to change your 
		appearance?",
	MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		closemessage
		turnobject(LOCALID_PLAYER, DIR_SOUTH)
		special(DynPal_ShowFullToneMenu)
    }
	releaseall
}