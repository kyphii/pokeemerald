movement NautirustForest_Intro_RivalExit {
	walk_fast_down * 7
}

movement(global) NautirustForest_Intro_RivalRacePath {
	walk_fast_up * 8
	walk_fast_right * 3

	delay_16
	face_right
	delay_16
	face_up
	delay_16

	walk_fast_up * 3
	walk_up * 5
	walk_right * 4
	walk_fast_right * 4
	walk_fast_up * 9
	walk_fast_left * 3
	walk_fast_up * 2
	walk_fast_left * 12
	walk_fast_up * 2
	walk_fast_left * 2
	walk_fast_up * 3
	walk_up

	emote_exclamation_mark
	delay_16 * 4
	jump_in_place_up * 2
	delay_16
	jump_in_place_up * 2
	delay_16
	jump_in_place_up * 2
	delay_16

	walk_up * 2
	walk_fast_up
	walk_up * 2
	walk_right * 3
	walk_fast_right * 2
	walk_fast_up * 5
	walk_fast_right * 4
	walk_right * 4
	walk_up * 5
	walk_fast_up * 2
	walk_up * 6
	walk_fast_up * 3
	walk_fast_left * 2
	
	delay_16
	face_up
	delay_16
	face_left
	delay_16
	face_up
	delay_16 * 2
	
	walk_fast_left * 4
	walk_left * 2
	walk_down * 4
	walk_left
	walk_down * 3
	walk_left * 3
	walk_fast_left * 6
	walk_left * 3
	walk_down
	
	emote_exclamation_mark
	delay_16 * 4
	jump_in_place_down * 2
	delay_16
	jump_in_place_down * 2
	delay_16
	jump_in_place_down * 2
	delay_16
	
	walk_down * 4
	walk_left * 2
	walk_fast_left * 2
	walk_fast_down * 4
	walk_fast_left * 5
	walk_fast_down * 5
	
	walk_down * 3
	walk_right
	walk_down
	walk_fast_down * 3
	walk_down * 2
	walk_right * 3
	walk_down * 3
	walk_fast_right * 3
	
	walk_fast_down
	walk_fast_right * 4
	walk_fast_down * 2
	walk_fast_right
	walk_fast_down * 4
	walk_fast_left * 3
	walk_fast_down
	walk_fast_left
	walk_fast_down
	walk_fast_left * 3
	
	walk_fast_down * 10
	walk_fast_left
	walk_fast_down * 4
}
