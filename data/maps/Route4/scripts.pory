mapscripts Route4_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		if (var(VAR_WANDERING_CAVE_LOCATION) == MAP_ROUTE4) {
			setmetatile(16, 61, METATILE_Overworld_CaveEntranceTop, TRUE)
			setmetatile(16, 62, METATILE_Overworld_CaveEntranceBottom, FALSE)
		}
	}
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_EXITED_WANDERING_CAVE, 1 {
			delay(30)
			special(WanderingCaveSetExit)
			setvar(VAR_EXITED_WANDERING_CAVE, 0)
			fadescreen(FADE_TO_BLACK)
			setmetatile(16, 61, METATILE_Overworld_CliffBottom_BrownShadow, TRUE)
			setmetatile(16, 62, METATILE_Overworld_CliffBottom_GreyShadow, TRUE)
			special(DrawWholeMapView)
			fadescreen(FADE_FROM_BLACK)
		}
	]
}

script Route4_Talk_OldPrincesTrailHint {
	lock
	fadeoutbgm(2)
	delay(90)
	msgbox(
		"…{PAUSE 10}…{PAUSE 10}…{PAUSE 10}…
		…The way{PAUSE 20} beneath…
		
		…{PAUSE 10}There{PAUSE 20} is{PAUSE 5} a{PAUSE 5} way{PAUSE 30} beneath…",
		MSGBOX_DEFAULT
	)
	closemessage
	
	getplayerxy(VAR_0x8008, VAR_0x8009)
	switch(var(VAR_0x8008)) {
		case 17:
		case 19:
			applymovement(VAR_LAST_TALKED, moves(
				walk_down * 8
			))
		case 18:
			applymovement(VAR_LAST_TALKED, moves(
				walk_right
				walk_down * 8
			))
	}
	waitmovement(0)
	removeobject(VAR_LAST_TALKED)
	setflag(FLAG_STORY_ROUTE4_TRAIL_HINT)
	
	fadeinbgm(1)
	release
}

script Route4_Sign_RouteSign {
	msgbox(
		"ROUTE 4
		{DOWN_ARROW} WHELCHORD CITY
		{RIGHT_ARROW} NAUTIRUST CITY
		{UP_ARROW} MOUNT BRIAR",
		MSGBOX_SIGN
	)
}

script Route4_Talk_IndecisiveWoman {
	lock
	faceplayer
	msgbox(
		"Oh dear, oh dear.
		I'm exhausted… This route is so rugged… 
		
		And it splits in two! 
		which way should I go?
		
		I could turn around back to Nautirust 
		City… but I already made it halfway to 
		Whelchord City!
		
		Oh, what to do?
		
		…Maybe I can just pitch a tent, and say 
		I live here now.",
		MSGBOX_DEFAULT
	)
	closemessage
	release
}

