script Mart_EventScript_Clerk {
	lock
	faceplayer
	message(gText_HowMayIServeYou)
	waitmessage
	getbadgecount
	switch (var(VAR_RESULT)) {
		case 0:
			pokemart(Mart_Pokemart_0)
		case 1:
			pokemart(Mart_Pokemart_1)
		case 2:
			pokemart(Mart_Pokemart_2)
		case 3:
			pokemart(Mart_Pokemart_3)
		case 4:
			pokemart(Mart_Pokemart_4)
		case 5:
			pokemart(Mart_Pokemart_5)
		case 6:
			pokemart(Mart_Pokemart_6)
		case 7:
			pokemart(Mart_Pokemart_7)
		case 8:
			pokemart(Mart_Pokemart_8)
	}
	msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)
	release
}

mart Mart_Pokemart_0 {
	ITEM_POKE_BALL
	ITEM_POTION
	ITEM_ANTIDOTE
	ITEM_PARALYZE_HEAL
}
mart Mart_Pokemart_1 {
	ITEM_POKE_BALL
	ITEM_POTION
	ITEM_SUPER_POTION
	ITEM_ANTIDOTE
	ITEM_PARALYZE_HEAL
	ITEM_AWAKENING
	ITEM_BURN_HEAL
	ITEM_ICE_HEAL
	ITEM_REPEL
}
